@model aws_lambda_hw.Models.OrderRequest

@{
    ViewData["Title"] = "Create Order";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <h3 class="mb-0">Create Order</h3>
                </div>

                <div class="card-body p-4">
                    @if (TempData["Success"] is string message)
                    {
                        <div class="alert alert-success" role="alert">
                            @message
                        </div>
                    }

                    <form asp-controller="Home"
                          asp-action="Index"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CustomerName"
                                   class="form-label">
                                Customer Name
                            </label>

                            <input asp-for="CustomerName"
                                   class="form-control"
                                   placeholder="Enter customer name"
                                   required />

                            <span asp-validation-for="CustomerName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProductName"
                                   class="form-label">
                                Product Name
                            </label>

                            <input asp-for="ProductName"
                                   class="form-control"
                                   placeholder="Enter product name"
                                   required />

                            <span asp-validation-for="ProductName"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price"
                                       class="form-label">
                                    Unit Price (€)
                                </label>

                                <input asp-for="Price"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="Price"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Quantity"
                                       class="form-label">
                                    Quantity
                                </label>

                                <input asp-for="Quantity"
                                       type="number"
                                       min="1"
                                       step="1"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="Quantity"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DeliveryMethod"
                                   class="form-label">
                                Delivery Method
                            </label>

                            <select asp-for="DeliveryMethod"
                                    asp-items="Html.GetEnumSelectList<DeliveryMethod>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="DeliveryMethod"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Place Order
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}